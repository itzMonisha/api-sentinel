# ==============================================================================
# API Sentinel — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual settings.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_sentinel
DB_USER=sentinel_user
DB_PASSWORD=your_secure_db_password_here

# JWT Security
JWT_SECRET=replace_with_a_secure_random_base64_or_hex_key_of_at_least_256_bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Outbound Network Security (SSRF Protection)
# Set to 'true' ONLY in isolated local development to test loopback/private APIs.
# MUST be 'false' in staging and production.
ALLOW_LOCAL_TARGETS=false
OUTBOUND_CONNECT_TIMEOUT_MS=5000
OUTBOUND_READ_TIMEOUT_MS=10000
OUTBOUND_MAX_RESPONSE_BYTES=5242880

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
