# ==============================================================================
# API Sentinel — Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Set VITE_API_URL only if the frontend is hosted on a separate origin/domain
# (e.g. https://api.apisentinel.dev).
# If the frontend is hosted behind an Nginx reverse proxy or on the same domain,
# leave empty to use relative /api requests.
VITE_API_URL=
